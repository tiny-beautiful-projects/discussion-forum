{{>layouts/header}}
<table class="table">
    <thead>
    <tr>
        <th scope="col">Id</th>
        <th scope="col">Email</th>
        <th scope="col">Password</th>
    </tr>
    </thead>
    <tbody>
    {{#member}}
        <tr>
            <th>{{id}}</th>
            <td>{{email}}</td>
            <td>{{password}}</td>
        </tr>
    {{/member}}
    </tbody>
</table>
<a href="/members">Go to member list page</a>
<!--수정 페이지로 가는 링크-->
<a href="/members/{{id}}/edit" class="btn btn-primary">Go to Edit Page</a>
<!--삭제 페이지로 가는 링크-->
<a href="/members/{{id}}/delete" class="btn btn-primary">Go to Delete Page</a>
{{>layouts/footer}}