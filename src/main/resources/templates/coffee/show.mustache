{{>layouts/header}}

<table class="table">
    <thead>
    <tr>
        <th scope="col">Id</th>
        <th scope="col">Name</th>
        <th scope="col">Price</th>
    </tr>
    </thead>
    <tbody>
    {{#coffeeDetail}}
        <tr>
            <th>{{id}}</th>
            <td>{{name}}</td>
            <td>{{price}}</td>
        </tr>
    {{/coffeeDetail}}
    </tbody>
</table>

<a href="/coffee" class="btn btn-primary">커피 목록 가기 </a>
<a href="/coffee/{{id}}/edit" class="btn btn-primary">커피 수정하러 가기</a>
{{>layouts/footer}}